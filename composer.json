{
  "name": "sugarcommerce/object-storage",
  "version": "1.1.0",
  "description": "A small client for one S3-compatible bucket — R2, S3, B2, MinIO: multipart uploads the browser does directly, ranged reads, the real stored size, presigned downloads and the bucket's CORS policy. Built on sugarcommerce/s3-signer and sugarcommerce/http-client.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/object-storage",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["s3", "r2", "object-storage", "multipart", "presigned", "cors"],
  "require": {
    "php": ">=8.5",
    "sugarcommerce/http-client": "^1.0",
    "sugarcommerce/s3-signer": "^1.0"
  },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\ObjectStorage\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\ObjectStorage\\Tests\\": "tests/" } },
  "repositories": [ { "type": "path", "url": "../*", "options": { "symlink": true } } ],
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/object-storage/issues", "source": "https://github.com/sugarcommerce/object-storage" }
}
